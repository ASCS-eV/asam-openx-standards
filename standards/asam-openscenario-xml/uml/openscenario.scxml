                <sc:Class>
                  <sc:name>SynchronizeAction</sc:name>
                  <sc:id>62</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Synchronizes an entity's arrival at a destination with a master entity. Both entities are provided with their own reference position which shall be reached at the same time. Final speed can be specified. Note that the reference positions can be different or identical.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Synchronizes an entity's arrival at a destination with a master entity. Both entities are provided with their own reference position which shall be reached at the same time. Final speed can be specified. Note that the reference positions can be different or identical.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
