                    </sc:Property>
                    <sc:Property>
                      <sc:name>stopTransition</sc:name>
                      <sc:id>106_226</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Transition between the running or standby states to the complete state. Occurs when the execution of the referenced StoryboardElement instance is stopped via a stop trigger or overriding.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Transition between the running or standby states to the complete state. Occurs when the execution of the referenced StoryboardElement instance is stopped via a stop trigger or overriding.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
