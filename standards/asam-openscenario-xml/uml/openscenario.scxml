                      <sc:typeName>boolean</sc:typeName>
                      <sc:isComposition>true</sc:isComposition>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>activateAnimation</sc:name>
                      <sc:id>165_435</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>True: The assigned controller gets activated the animation domain. False: the assigned animation controller gets deactivated. If not specified: No change for controlling the animation domain is applied.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
