                          <sc:descriptorValues>
                            <sc:DescriptorValue>The value is either a delta (Unit: [m/s]) or a factor (no Unit).</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The value is either a delta (Unit: [m/s]) or a factor (no Unit).</sc:DescriptorValue>
