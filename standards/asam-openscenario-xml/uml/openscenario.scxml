    <sc:Association>
      <sc:name>ClothoidSplineSegment_Position</sc:name>
      <sc:id>as467</sc:id>
      <sc:descriptors>
        <sc:definition>
          <sc:descriptorValues>
            <sc:DescriptorValue>Optional start position of the clothoid segment. If omitted for the first segment, then the current position of the entity, which follows this trajectory is used as start position. If omitted for subsequent segments, then the end position of the previous segment shall be used as start position. If only the heading component of the position is omitted than the heading of the end position of the previous segment shall be used.</sc:DescriptorValue>
          </sc:descriptorValues>
        </sc:definition>
        <sc:documentation>
