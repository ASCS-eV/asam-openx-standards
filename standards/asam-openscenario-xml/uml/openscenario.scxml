                <sc:Class>
                  <sc:name>RelativeDistanceCondition</sc:name>
                  <sc:id>131</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>The current relative distance of a triggering entity/entities to a reference entity is compared to a given value. The logical operator used for comparison is defined in the rule attribute.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>The current relative distance of a triggering entity/entities to a reference entity is compared to a given value. The logical operator used for comparison is defined in the rule attribute.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
                  <sc:properties>
