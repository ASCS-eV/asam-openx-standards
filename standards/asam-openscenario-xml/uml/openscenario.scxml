                <sc:Class>
                  <sc:name>ManeuverGroup</sc:name>
                  <sc:id>14</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Grouping element connecting a set of actors to a set maneuvers. Multiple maneuver groups can run independently in parallel. Maneuvers can be defined or instantiated from a maneuver type in a catalog.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Grouping element connecting a set of actors to a set maneuvers. Multiple maneuver groups can run independently in parallel. Maneuvers can be defined or instantiated from a maneuver type in a catalog.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
                  <sc:properties>
                    <sc:Property>
                      <sc:name>maximumExecutionCount</sc:name>
