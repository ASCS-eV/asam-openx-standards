                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Number of allowed executions of the maneuver group. Default value is 1. Range: [1..inf[.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
