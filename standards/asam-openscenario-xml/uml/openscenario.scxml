                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Action that toggles (on or off) an entity's visibility attributes, with respect to sensors, other traffic or the graphics engine. The default for entities is that they are visible everywhere.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
