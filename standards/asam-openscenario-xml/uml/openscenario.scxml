                <sc:Class>
                  <sc:name>TriggeringEntitiesRule</sc:name>
                  <sc:id>108</sc:id>
                  <sc:stereotypes>
                    <sc:Stereotype>enumeration</sc:Stereotype>
                  </sc:stereotypes>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Rules which determine how triggering entities are used to verify a given condition.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Rules which determine how triggering entities are used to verify a given condition.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
                  <sc:properties>
                    <sc:Property>
                      <sc:name>all</sc:name>
                      <sc:id>108_234</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>All listed triggering entities must reach the specifies position in order to start the lane change.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>All listed triggering entities must reach the specifies position in order to start the lane change.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741789</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>any</sc:name>
                      <sc:id>108_235</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>One of the triggering entities reaching the position is enough to trigger the lane change.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>One of the triggering entities reaching the position is enough to trigger the lane change.</sc:DescriptorValue>
