                            <sc:DescriptorValue>The operator (less, greater, equal).</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The operator (less, greater, equal).</sc:DescriptorValue>
                          </sc:descriptorValues>
