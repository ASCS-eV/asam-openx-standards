      <sc:id>as70</sc:id>
      <sc:descriptors>
        <sc:definition>
          <sc:descriptorValues>
            <sc:DescriptorValue>Each phase can have multiple TrafficSignalStates to provide the observable state for all traffic signals individually that are controlled by the controller. One for each TrafficSignal. E.g. name="go" (trafficSignal1:"off;off;on", trafficSignal2:"off;off;on").</sc:DescriptorValue>
          </sc:descriptorValues>
        </sc:definition>
