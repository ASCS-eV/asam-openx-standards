                    <sc:Property>
                      <sc:name>continuous</sc:name>
                      <sc:id>335_609</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>If false, then traffic shall be only spawned once when the action is started and the action ends immediately. If true, then continuously the spawned traffic is despawned when it leaves the area and new traffic is spawned in the area to keep a constant number of entities.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
