                <sc:Class>
                  <sc:name>RelativeTargetSpeed</sc:name>
                  <sc:id>139</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Defines a target speed relative to a reference entity's speed.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Defines a target speed relative to a reference entity's speed.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
                  <sc:properties>
                    <sc:Property>
                      <sc:name>continuous</sc:name>
                      <sc:id>139_88</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>By setting continuous to true a controller comes into place and tries to maintain a continuous relative speed. This may not be used together with Dynamics.time or Dynamics.distance.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
