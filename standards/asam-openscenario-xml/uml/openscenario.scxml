                <sc:Class>
                  <sc:name>RelativeObjectPosition</sc:name>
                  <sc:id>133</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Defines a position derived from coordinates (dx, dy and dz) relative to a reference entity. The coordinate system for the relative coordinates is the reference entity's coordinate system (taking the orientation of the entity into account).</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
