                      <sc:id>298_467</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The upper limit of the range. Range: ]-inf, inf]. Default if omitted: +inf</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The upper limit of the range. Range: ]-inf, inf]. Default if omitted: +inf</sc:DescriptorValue>
