                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>True: The assigned controller gets activated the lighting domain. False: the assigned lighting controller gets deactivated. If not specified: No change for controlling the lighting domain is applied.</sc:DescriptorValue>
                          </sc:descriptorValues>
