                          <sc:descriptorValues>
                            <sc:DescriptorValue>Name of the phase used for referencing in TrafficSignalControllerCondition or TrafficSignalControllerAction. Must be unique among the phases of the same TrafficSignalController.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
