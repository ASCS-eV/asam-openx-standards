      <sc:id>as294</sc:id>
      <sc:descriptors>
        <sc:definition>
          <sc:descriptorValues>
            <sc:DescriptorValue>Defines zero or more constraint groups to the parameter value. Multiple constraint groups are combined by an OR. That means at least one constraint group has to evaluate to true to get the simulation started. If none of the constraint groups is satisfied the scenario should not be evaluated.</sc:DescriptorValue>
          </sc:descriptorValues>
        </sc:definition>
