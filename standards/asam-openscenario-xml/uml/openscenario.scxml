                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Transition between the standby and running state. The moment the referenced StoryboardElement instance starts its execution.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Transition between the standby and running state. The moment the referenced StoryboardElement instance starts its execution.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
