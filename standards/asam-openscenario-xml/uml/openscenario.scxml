                  <sc:id>92</sc:id>
                  <sc:stereotypes>
                    <sc:Stereotype>enumeration</sc:Stereotype>
                  </sc:stereotypes>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Edge types that can be used for conditions.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Edge types that can be used for conditions.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
                  <sc:properties>
                    <sc:Property>
                      <sc:name>falling</sc:name>
                      <sc:id>92_160</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A condition defined with a falling edge shall return true at discrete time t if its logical expression is false at discrete time t and its logical expression was true at discrete time t-ts, where ts is the simulation sampling time.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A condition defined with a falling edge shall return true at discrete time t if its logical expression is false at discrete time t and its logical expression was true at discrete time t-ts, where ts is the simulation sampling time.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741198</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>none</sc:name>
                      <sc:id>92_161</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A condition defined with a 'none' edge shall return true at discrete time t if its logical expression is true at discrete time t.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A condition defined with a 'none' edge shall return true at discrete time t if its logical expression is true at discrete time t.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741197</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>rising</sc:name>
                      <sc:id>92_162</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A condition defined with a rising edge shall return true at discrete time t if its logical expression is true at discrete time t and its logical expression was false at discrete time t-ts, where ts is the simulation sampling time.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A condition defined with a rising edge shall return true at discrete time t if its logical expression is true at discrete time t and its logical expression was false at discrete time t-ts, where ts is the simulation sampling time.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741196</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>risingOrFalling</sc:name>
                      <sc:id>92_163</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A condition defined with a 'risingOrFalling' edge shall return true at discrete time t if its logical expression is true at discrete time t and its logical expression was false at discrete time t-ts OR if its logical expression is false at discrete time t and its logical expression was true at discrete time t-ts. ts is the simulation sampling time.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A condition defined with a 'risingOrFalling' edge shall return true at discrete time t if its logical expression is true at discrete time t and its logical expression was false at discrete time t-ts OR if its logical expression is false at discrete time t and its logical expression was true at discrete time t-ts. ts is the simulation sampling time.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741195</sc:sequenceNumber>
                    </sc:Property>
                  </sc:properties>
