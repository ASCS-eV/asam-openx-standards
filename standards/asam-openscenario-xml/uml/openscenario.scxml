                      <sc:id>350_625</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Tolerance around the given angle value. Unit: [rad]. Range: [0..pi].</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Tolerance around the given angle value. Unit: [rad]. Range: [0..pi].</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741312</sc:sequenceNumber>
                      <sc:typeName>double</sc:typeName>
