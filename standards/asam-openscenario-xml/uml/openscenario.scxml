                <sc:Class>
                  <sc:name>AngleCondition</sc:name>
                  <sc:id>350</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Checks if a triggering entity has reached a given angle in a specific angular coordinate, within some user-specified angle tolerance.&#xD;&#xA;&#xD;&#xA;The angle can be measured in the global world coordinate system or in s-t coordinates like road, lane or trajectory coordinates. In case of s-t coordinates, the orientation is measured at the local s-coordinate of the triggering entity.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Checks if a triggering entity has reached a given angle in a specific angular coordinate, within some user-specified angle tolerance.&#xD;&#xA;&#xD;&#xA;The angle can be measured in the global world coordinate system or in s-t coordinates like road, lane or trajectory coordinates. In case of s-t coordinates, the orientation is measured at the local s-coordinate of the triggering entity.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
                  <sc:properties>
                    <sc:Property>
                      <sc:name>angleType</sc:name>
                      <sc:id>350_621</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The angular coordinate to be used for the condition.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The angular coordinate to be used for the condition.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741314</sc:sequenceNumber>
                      <sc:typeId>349</sc:typeId>
                      <sc:typeName>AngleType</sc:typeName>
                      <sc:isComposition>true</sc:isComposition>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>angle</sc:name>
                      <sc:id>350_622</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The angle value that will be compared to the triggering entity's orientation. Unit: [rad]. Range: [-pi..pi].</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The angle value that will be compared to the triggering entity's orientation. Unit: [rad]. Range: [-pi..pi].</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741313</sc:sequenceNumber>
