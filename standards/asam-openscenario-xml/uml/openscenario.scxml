                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Defines a distribution, which direction of travel of the swarm traffic relative to the central object should be used.&#xD;&#xA;Represents the weight of a given direction of travel. The relative probability for the occurence of this direction of travel is defined by the weight devided by the sum of all weights of this distribution.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
