                  <sc:stereotypes>
                    <sc:Stereotype>union</sc:Stereotype>
                  </sc:stereotypes>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>This action assigns an object controller to the given entity defined in the enclosing PrivateAction.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>This action assigns an object controller to the given entity defined in the enclosing PrivateAction. </sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
                  <sc:properties>
                    <sc:Property>
                      <sc:name>activateLateral</sc:name>
                      <sc:id>165_355</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>True: The assigned controller gets activated for the lateral dimension. False: the assigned controller gets deactivated for the lateral dimension. If not specified: No change for controlling the lateral dimension is applied.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>True: The assigned controller gets activated for the lateral dimension. False: the assigned controller gets deactivated for the lateral dimension. If not specified: No change for controlling the lateral dimension is applied.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:cardinality>0..1</sc:cardinality>
                      <sc:sequenceNumber>-1073741673</sc:sequenceNumber>
                      <sc:typeName>boolean</sc:typeName>
                      <sc:isComposition>true</sc:isComposition>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>activateLongitudinal</sc:name>
                      <sc:id>165_356</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>True: The assigned controller gets activated for the longitudinal dimension. False: the assigned controller gets deactivated for the longitudinal dimension. If not specified: No change for controlling the longitudinal  dimension is applied.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
