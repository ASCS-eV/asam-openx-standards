                            <sc:DescriptorValue>Maximum lateral acceleration used to initially reach and afterwards keep the lane offset. Missing value is interpreted as 'inf'. Unit: [m/s²]. Range: [0..inf[.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
