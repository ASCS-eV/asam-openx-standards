                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>A condition represents a set of logical expressions that evaluate the relationship of values provided by the user. These values may be entity states, scenario properties, scenario states or external signals. Conditions are the main components in triggers.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
