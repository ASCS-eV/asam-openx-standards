                      <sc:id>134_264</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The offset on the axis orthogonal to the road's reference line relative to the t-coordinate of the reference entity. Unit: [m].</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The offset on the axis orthogonal to the road's reference line relative to the t-coordinate of the reference entity. Unit: [m].</sc:DescriptorValue>
                          </sc:descriptorValues>
