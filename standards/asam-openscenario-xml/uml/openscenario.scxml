                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Defines shape and lateral acceleration which are used to do the lane offset action.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
