                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The maximum number of spawned entities in the area. Depending on the size of the area and the available spawning positions on the included roads, less than numberOfEntities might be set up. Range: [0..inf[.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The maximum number of spawned entities in the area. Depending on the size of the area and the available spawning positions on the included roads, less than numberOfEntities might be set up. Range: [0..inf[.</sc:DescriptorValue>
