                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Defines an action that adds or deletes a referred entity.&#xD;&#xA;Entities to be added or deleted must be defined in the Entities section.&#xD;&#xA;An entity can only exist in one copy. Adding an already active entity will have no effect, neither will deleting an already inactive entity.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
