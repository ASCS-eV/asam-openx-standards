                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Each phase can have one TrafficSignalGroupState to provide the observable state for all traffic signals that are controlled by the controller if they share the same state. E.g. semantics="go" ("off;off;on").</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
