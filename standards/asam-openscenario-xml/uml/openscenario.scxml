                <sc:Class>
                  <sc:name>TrafficStopAction</sc:name>
                  <sc:id>178</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>This action stops one or more  traffic instances. The instances to be stopped are identified by their name. All active traffic instances with this name are stopped.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>This action stops one or more  traffic instances. The instances to be stopped are identified by their name. All active traffic instances with this name are stopped.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
                </sc:Class>
                <sc:Class>
                  <sc:name>UsedArea</sc:name>
                  <sc:id>179</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>The area that is used by the entities. When using big road network and/or scene files (several GB, e.g. for whole Europe), a simulator shall not load the whole road network for performance reasons.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>The area that is used by the entities. When using big road network and/or scene files (several GB, e.g. for whole Europe), a simulator shall not load the whole road network for performance reasons.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
