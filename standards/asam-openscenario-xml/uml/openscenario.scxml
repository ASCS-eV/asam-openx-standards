                <sc:Class>
                  <sc:name>RelativeLaneRange</sc:name>
                  <sc:id>298</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>A range of lanes to the left and/or right of a referenced entity. The properties "from" and "to" define the signed numbers of lanes that are offset the referenced entity's current lane. (0 is the entity's current lane, positive is left of the entity, negative is right of the entity). Set "from" and "to" to the same number in order to check clearance for only one lane.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>A range of lanes to the left and/or right of a referenced entity. The properties "from" and "to" define the signed numbers of lanes that are offset the referenced entity's current lane. (0 is the entity's current lane, positive is left of the entity, negative is right of the entity). Set "from" and "to" to the same number in order to check clearance for only one lane.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
                  <sc:properties>
                    <sc:Property>
                      <sc:name>from</sc:name>
                      <sc:id>298_466</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The lower limit of the range. Range: [-inf, inf[. Default if omitted: -inf</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The lower limit of the range. Range: [-inf, inf[. Default if omitted: -inf</sc:DescriptorValue>
