                      <sc:id>137_86</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Signed number defining the target lane as difference compared to the reference entity's current lane evaluated in the reference entity's coordinate system.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Signed number defining the target lane as difference compared to the reference entity's current lane evaluated in the reference entity's coordinate system.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741719</sc:sequenceNumber>
