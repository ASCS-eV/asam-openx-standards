                      <sc:id>139_90</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Value of the relative speed. This value is either given as a delta or as a factor. E.g. value=10 together with valueType=delta means the entity/entities are supposed to drive 10m/s faster than the target reference entity. E.g. value=1.1 together with valueType=factor means that the entity/entities are supposed to drive 10% faster than the target reference entity. Unit: [m/s] or [1].</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
