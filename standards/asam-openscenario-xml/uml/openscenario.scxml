    <sc:Association>
      <sc:name>FollowTrajectoryAction_TimeReference</sc:name>
      <sc:id>as111</sc:id>
      <sc:descriptors>
        <sc:definition>
          <sc:descriptorValues>
            <sc:DescriptorValue>Defines if time information provided within the trajectory should be considered. If so, it may be used as either absolute or relative time along the trajectory in order to define longitudinal velocity of the actor. Moreover, a time offset or time scaling may be applied.</sc:DescriptorValue>
          </sc:descriptorValues>
        </sc:definition>
        <sc:documentation>
          <sc:descriptorValues>
