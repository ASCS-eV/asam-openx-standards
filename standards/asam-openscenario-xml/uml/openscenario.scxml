                  <sc:properties>
                    <sc:Property>
                      <sc:name>followingMode</sc:name>
                      <sc:id>309_486</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Defines whether to apply strictly linear interpolation between speed target values (mode=position), or to apply jerk (change rate of acceleration/deceleration) and other optional constraints of the Performance class of a Vehicle entity resulting in a smoother speed profile curve (mode=follow). For mode=follow the acceleration is zero at the start and end of the profile.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Defines whether to apply strictly linear interpolation between speed target values (mode=position), or to apply jerk (change rate of acceleration/deceleration) and other optional constraints of the Performance class of a Vehicle entity resulting in a smoother speed profile curve (mode=follow). For mode=follow the acceleration is zero at the start and end of the profile.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
