                    </sc:Property>
                    <sc:Property>
                      <sc:name>lane</sc:name>
                      <sc:id>222_347</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Road-based s,t coordinate system (s-axis is the lane center line of the lane, on which the entity is located).</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Road-based s,t coordinate system (s-axis is the lane center line of the lane, on which the entity is located).</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741602</sc:sequenceNumber>
