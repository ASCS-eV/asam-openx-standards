                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Defines geometric properties of the entities as a simplified three dimensional bounding box.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
