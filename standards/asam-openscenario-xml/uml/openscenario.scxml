                <sc:Class>
                  <sc:name>VehicleCategory</sc:name>
                  <sc:id>109</sc:id>
                  <sc:stereotypes>
                    <sc:Stereotype>enumeration</sc:Stereotype>
                  </sc:stereotypes>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Categories for entity objects of type vehicle.&#xD;&#xA;It is recommended to use the most specific literal that fits whenever possible (e.g. 'heavyTruck' instead of 'car'). &#xD;&#xA;The enum literals have been harmonized between ASAM OpenX standards. The latest details about the harmonization can be found under https://publications.pages.asam.net/standards/ASAM_TrafficParticipants_Specification/ASAM_TrafficParticipants_Specification/latest/specification/index.html.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Categories for entity objects of type vehicle.&#xD;&#xA;It is recommended to use the most specific literal that fits whenever possible (e.g. 'heavyTruck' instead of 'car'). &#xD;&#xA;The enum literals have been harmonized between ASAM OpenX standards. The latest details about the harmonization can be found under https://publications.pages.asam.net/standards/ASAM_TrafficParticipants_Specification/ASAM_TrafficParticipants_Specification/latest/specification/index.html.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
                  <sc:properties>
                    <sc:Property>
                      <sc:name>aircraft</sc:name>
                      <sc:id>109_634</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>An aircraft is a vehicle designed for flight through the air (airplanes, helicopters, etc.). This category is deliberately generic and may be refined in future versions as needed.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>An aircraft is a vehicle designed for flight through the air (airplanes, helicopters, etc.). This category is deliberately generic and may be refined in future versions as needed.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741787</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>bicycle</sc:name>
                      <sc:id>109_236</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A bicycle is a human-powered or motor-assisted, pedal-driven vehicle. This category includes typical two-wheeled bicycles as well as cargo-bikes and other pedal-driven vehicles with more than two wheels.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A bicycle is a human-powered or motor-assisted, pedal-driven vehicle. This category includes typical two-wheeled bicycles as well as cargo-bikes and other pedal-driven vehicles with more than two wheels.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741786</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>bus</sc:name>
                      <sc:id>109_237</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A bus is a motorized vehicle designed to carry multiple passengers.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A bus is a motorized vehicle designed to carry multiple passengers.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741785</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>car</sc:name>
                      <sc:id>109_238</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A car is a motorized vehicle designed primarily for passenger transportation. A car typically has four wheels.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A car is a motorized vehicle designed primarily for passenger transportation. A car typically has four wheels.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741784</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>heavyTruck</sc:name>
                      <sc:id>109_635</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A heavy truck is a large commercial vehicle designed for transporting heavy loads. The cargo area is rigidly fixed to the vehicle itself.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A heavy truck is a large commercial vehicle designed for transporting heavy loads. The cargo area is rigidly fixed to the vehicle itself.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741783</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>landVehicle</sc:name>
                      <sc:id>109_655</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A land vehicle is a vehicle designed for travel on land. This category is deliberately generic to include land vehicles that do not fall into other categories and may be refined in future versions as needed.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A land vehicle is a vehicle designed for travel on land. This category is deliberately generic to include land vehicles that do not fall into other categories and may be refined in future versions as needed.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741782</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>micromobilityDevice</sc:name>
                      <sc:id>109_637</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A micro-mobility device is a small, lightweight vehicle for short-distance travel, like hoverboards or roller skates. While bicycles, stand-up scooters, and wheelchairs may technically fall into this category, the respective detailed categories shall be used instead.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A micro-mobility device is a small, lightweight vehicle for short-distance travel, like hoverboards or roller skates. While bicycles, stand-up scooters, and wheelchairs may technically fall into this category, the respective detailed categories shall be used instead.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741781</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>motorbike</sc:name>
                      <sc:id>109_239</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The vehicle is a motor bike.&#xD;&#xA;DEPRECATED: Use 'motorcycle' instead.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The vehicle is a motor bike.&#xD;&#xA;DEPRECATED: Use 'motorcycle' instead.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741780</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>motorcycle</sc:name>
                      <sc:id>109_638</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A motorcycle is a motorized vehicle designed primarily for passenger transportation. Compared to a car, fewer passive safety features, such as a full passenger cell, are typically present. This category includes both two-wheeled motorcycles and three-wheeled vehicles like motorcycles with side-cars or trikes.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A motorcycle is a motorized vehicle designed primarily for passenger transportation. Compared to a car, fewer passive safety features, such as a full passenger cell, are typically present. This category includes both two-wheeled motorcycles and three-wheeled vehicles like motorcycles with side-cars or trikes.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741779</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>other</sc:name>
                      <sc:id>109_636</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Other (unspecified but known) type of vehicle.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Other (unspecified but known) type of vehicle.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741778</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>semitractor</sc:name>
                      <sc:id>109_639</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A semi-tractor is a vehicle designed for towing semi-trailers for the transportation of heavy loads.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A semi-tractor is a vehicle designed for towing semi-trailers for the transportation of heavy loads.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741777</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>semitrailer</sc:name>
                      <sc:id>109_240</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A semi-trailer is a vehicle designed for being towed by a semi-tractor. Characteristics compared to a regular trailer are the large size, the fact that a large portion of the weight is supported at the hitch, and a large overlap with the towing vehicle, i.e. the semi-tractor.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A semi-trailer is a vehicle designed for being towed by a semi-tractor. Characteristics compared to a regular trailer are the large size, the fact that a large portion of the weight is supported at the hitch, and a large overlap with the towing vehicle, i.e. the semi-tractor.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741776</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>standupScooter</sc:name>
                      <sc:id>109_640</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A stand-up scooter is a compact, typically two-wheeled device. It is operated with the rider standing on a deck between the wheels. It may be propelled by a motor or the rider making a kicking movement.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A stand-up scooter is a compact, typically two-wheeled device. It is operated with the rider standing on a deck between the wheels. It may be propelled by a motor or the rider making a kicking movement.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741775</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>trailer</sc:name>
                      <sc:id>109_241</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A trailer is a non-motorized vehicle designed for being towed by a motorized vehicle to carry goods, animals, or people.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A trailer is a non-motorized vehicle designed for being towed by a motorized vehicle to carry goods, animals, or people.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741774</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>train</sc:name>
                      <sc:id>109_242</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A train is a vehicle designed for the transport of passengers and freight on rail infrastructure. The rail infrastructure for trains is mostly grade-separated from the public road infrastructure as trains have exclusive right-of-way. Therefore, in case crossings with the road infrastructure occur, the exclusive right-of-way is ensured, e.g. by railway barriers. A train often acts as a series of connected vehicles.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A train is a vehicle designed for the transport of passengers and freight on rail infrastructure. The rail infrastructure for trains is mostly grade-separated from the public road infrastructure as trains have exclusive right-of-way. Therefore, in case crossings with the road infrastructure occur, the exclusive right-of-way is ensured, e.g. by railway barriers. A train often acts as a series of connected vehicles.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741773</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>tram</sc:name>
                      <sc:id>109_243</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A tram is a vehicle designed for using rail infrastructure for the transport of passengers on rail infrastructure. The rail infrastructure may fully or partially overlap with public road infrastructure. In contrast to trains, trams do not have exclusive right-of-way. A tram often acts as a series of connected vehicles.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A tram is a vehicle designed for using rail infrastructure for the transport of passengers on rail infrastructure. The rail infrastructure may fully or partially overlap with public road infrastructure. In contrast to trains, trams do not have exclusive right-of-way. A tram often acts as a series of connected vehicles.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741772</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>truck</sc:name>
                      <sc:id>109_244</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The vehicle is a truck. &#xD;&#xA;DEPRECATED: Use more specific categories 'heavyTruck' or 'semitractor' instead.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>The vehicle is a truck. &#xD;&#xA;DEPRECATED: Use more specific categories 'heavyTruck' or 'semitractor' instead.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741771</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>van</sc:name>
                      <sc:id>109_245</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A van is a motorized vehicle with a larger cargo area than a car, used for transporting goods or people. This category is not intended for mini vans, which shall rather be categorized as cars.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A van is a motorized vehicle with a larger cargo area than a car, used for transporting goods or people. This category is not intended for mini vans, which shall rather be categorized as cars.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741770</sc:sequenceNumber>
                    </sc:Property>
                    <sc:Property>
                      <sc:name>watercraft</sc:name>
                      <sc:id>109_641</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A watercraft is a vehicle designed for travel on water (boats, ships, etc.). This category is deliberately generic and may be refined in future versions as needed.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A watercraft is a vehicle designed for travel on water (boats, ships, etc.). This category is deliberately generic and may be refined in future versions as needed.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
                      </sc:descriptors>
                      <sc:sequenceNumber>-1073741769</sc:sequenceNumber>
