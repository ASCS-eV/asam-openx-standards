                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:double;
                           owl:onProperty               odr:T_road_objects_object_skeleton_polyline_vertexLocal.radius
                         ];
        skos:definition  "Defines a vertex point on the object polyline relative to the object's origin in local u/v-coordinates. The origin and the orientation of the object are given by the @s, @t, @zOffset and @hdg attributes of the element. <vertexLocal> can use either radius or length/width within one <polyline> element."@en .

odr:T_road_lanes_laneSection_lr_lane.advisory
        rdf:type         owl:ObjectProperty;
