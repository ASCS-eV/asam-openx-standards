odr:T_signalGroup_vmsBoardReference
        rdf:type         owl:Class;
        rdfs:comment     "Variable message board references list all variable message boards that belong to the same gantry."@en;
        rdfs:label       "t_signalGroup_vmsBoardReference"@en;
        rdfs:subClassOf  odr:_OpenDriveElement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:int;
                           owl:onProperty            odr:T_signalGroup_vmsBoardReference.groupIndex;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:int;
                           owl:onProperty            odr:T_signalGroup_vmsBoardReference.vmsIndex;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:string;
                           owl:onProperty            odr:T_signalGroup_vmsBoardReference.signalId;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        skos:definition  "Variable message board references list all variable message boards that belong to the same gantry."@en .

