        skos:definition  "s-coordinate where the connection meets the preceding / succeeding road."@en .

odr:T_road  rdf:type     owl:Class;
        rdfs:comment     "Roads are the core elements for any road network in ASAM OpenDRIVE. Each road runs along one road reference line.\r\nA road shall have at least the center lane. Vehicles may drive in both directions of the road reference line. The standard driving direction is defined by the value which is assigned to the @rule attribute (RHT=right-hand traffic, LHT=left-han traffic).\r\nASAM OpenDRIVE roads may be roads in the real road network or artificial road network created for application use. Each road is described by one or more <road> elements. One <road> element may cover a long stretch of a road, shorter stretches between junctions, or even several roads. A new <road> element should only start if the properties of the road cannot be described within the previous <road> element or if a junction is required.d"@en;
        rdfs:label       "t_road"@en;
        rdfs:subClassOf  odr:_OpenDriveElement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:string;
                           owl:onProperty            odr:T_road.id;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:minQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_lanes;
                           owl:onProperty               odr:T_road.lanes
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_elevationProfile;
                           owl:onProperty               odr:T_road.elevationProfile
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:string;
                           owl:onProperty            odr:T_road.junction;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_objects;
                           owl:onProperty               odr:T_road.objects
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_surface;
                           owl:onProperty               odr:T_road.surface
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               odr:T_road_planView;
                           owl:onProperty            odr:T_road.planView;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  owl:Class;
                           owl:onProperty               odr:T_road.rule
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road.length;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:string;
                           owl:onProperty               odr:T_road.name
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_railroad;
                           owl:onProperty               odr:T_road.railroad
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_signals;
                           owl:onProperty               odr:T_road.signals
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "2"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_lanes;
                           owl:onProperty               odr:T_road.lanes
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_lateralProfile;
                           owl:onProperty               odr:T_road.lateralProfile
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_link;
                           owl:onProperty               odr:T_road.link
                         ];
        skos:definition  "Roads are the core elements for any road network in ASAM OpenDRIVE. Each road runs along one road reference line.\r\nA road shall have at least the center lane. Vehicles may drive in both directions of the road reference line. The standard driving direction is defined by the value which is assigned to the @rule attribute (RHT=right-hand traffic, LHT=left-han traffic).\r\nASAM OpenDRIVE roads may be roads in the real road network or artificial road network created for application use. Each road is described by one or more <road> elements. One <road> element may cover a long stretch of a road, shorter stretches between junctions, or even several roads. A new <road> element should only start if the properties of the road cannot be described within the previous <road> element or if a junction is required.d"@en .

