odr:T_road_objects_object
        rdf:type         owl:Class;
        rdfs:comment     "Objects influence a road by expanding, delimiting, or supplementing its course. Objects are elements that form the environment, for example, buildings, guard rails, poles, and trees. Objects are not mandatory to guide driver and traffic models, unlike signals.\r\nThere are two ways to describe the bounding volume of objects.\r\n\t- For an angular object: definition of the width, length and height.\r\n\t- For a circular object: definition of the radius and height."@en;
        rdfs:label       "t_road_objects_object"@en;
        rdfs:subClassOf  odr:_OpenDriveElement;
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:boolean;
                           owl:onProperty               odr:T_road_objects_object.temporary
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:boolean;
                           owl:onProperty               odr:T_road_objects_object.perpToRoad
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:boolean;
                           owl:onProperty               odr:T_road_objects_object.invalidated
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  owl:Class;
                           owl:onProperty               odr:T_road_objects_object.dynamic
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road_objects_object.zOffset;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:string;
                           owl:onProperty            odr:T_road_objects_object.id;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_objects_object_outlines_outline;
                           owl:onProperty               odr:T_road_objects_object.outline
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_objects_object_parkingSpace;
                           owl:onProperty               odr:T_road_objects_object.parkingSpace
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  owl:Class;
                           owl:onProperty               odr:T_road_objects_object.orientation
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_objects_object_skeleton;
                           owl:onProperty               odr:T_road_objects_object.skeleton
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:string;
                           owl:onProperty               odr:T_road_objects_object.name
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:double;
                           owl:onProperty               odr:T_road_objects_object.roll
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:double;
                           owl:onProperty               odr:T_road_objects_object.width
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:double;
                           owl:onProperty               odr:T_road_objects_object.validLength
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:double;
                           owl:onProperty               odr:T_road_objects_object.pitch
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_objects_object_markings;
                           owl:onProperty               odr:T_road_objects_object.markings
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  owl:Class;
                           owl:onProperty               odr:T_road_objects_object.type
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_objects_object_outlines;
                           owl:onProperty               odr:T_road_objects_object.outlines
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:string;
                           owl:onProperty               odr:T_road_objects_object.subtype
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_objects_object_surface;
                           owl:onProperty               odr:T_road_objects_object.surface
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_objects_object_borders;
                           owl:onProperty               odr:T_road_objects_object.borders
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:double;
                           owl:onProperty               odr:T_road_objects_object.hdg
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road_objects_object.s;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:double;
                           owl:onProperty               odr:T_road_objects_object.height
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:double;
                           owl:onProperty               odr:T_road_objects_object.length
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road_objects_object.t;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:double;
                           owl:onProperty               odr:T_road_objects_object.radius
                         ];
        skos:definition  "Objects influence a road by expanding, delimiting, or supplementing its course. Objects are elements that form the environment, for example, buildings, guard rails, poles, and trees. Objects are not mandatory to guide driver and traffic models, unlike signals.\r\nThere are two ways to describe the bounding volume of objects.\r\n\t- For an angular object: definition of the width, length and height.\r\n\t- For a circular object: definition of the radius and height."@en .

odr:T_road_objects_object.orientation
        rdf:type         owl:ObjectProperty;
        rdfs:comment     "\"+\" = valid in positive s-direction\r\n\"-\" = valid in negative s-direction\r\n\"none\" = valid in both directions\r\n(does not affect the heading)"@en;
        rdfs:domain      odr:T_road_objects_object;
        rdfs:label       "orientation"@en;
        rdfs:range       owl:Class;
        skos:definition  "\"+\" = valid in positive s-direction\r\n\"-\" = valid in negative s-direction\r\n\"none\" = valid in both directions\r\n(does not affect the heading)"@en .

