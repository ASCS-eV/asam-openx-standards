@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit_line.rule
        rdf:type         owl:ObjectProperty;
        rdfs:comment     "Rule that must be observed when passing the line from inside, that is, from the lane with the lower absolute ID to the lane with the higher absolute ID"@en;
        rdfs:domain      odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit_line;
        rdfs:label       "rule"@en;
        rdfs:range       owl:Class;
        skos:definition  "Rule that must be observed when passing the line from inside, that is, from the lane with the lower absolute ID to the lane with the higher absolute ID"@en .

odr:T_road.elevationProfile
        rdf:type     owl:ObjectProperty;
        rdfs:domain  odr:T_road;
        rdfs:label   "elevationProfile"@en;
        rdfs:range   odr:T_road_elevationProfile .

odr:T_road_signals.signalReference
        rdf:type     owl:ObjectProperty;
        rdfs:domain  odr:T_road_signals;
        rdfs:label   "signalReference"@en;
        rdfs:range   odr:T_road_signals_signalReference .

odr:T_road_signals_board.validity
        rdf:type     owl:ObjectProperty;
