odr:T_road_objects_tunnel
        rdf:type         owl:Class;
        rdfs:comment     "Tunnels are modeled as objects in ASAM OpenDRIVE. The road with the tunnel object defines the part of the road that is the tunnel or the underpass.\r\nTunnels are valid for the complete cross section of a road unless a lane validity element with further restrictions is provided as child element"@en;
        rdfs:label       "t_road_objects_tunnel"@en;
        rdfs:subClassOf  odr:_OpenDriveElement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road_objects_tunnel.s;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:double;
                           owl:onProperty               odr:T_road_objects_tunnel.lighting
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               owl:Class;
                           owl:onProperty            odr:T_road_objects_tunnel.type;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road_objects_tunnel.length;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:double;
                           owl:onProperty               odr:T_road_objects_tunnel.daylight
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:string;
                           owl:onProperty            odr:T_road_objects_tunnel.id;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:string;
                           owl:onProperty               odr:T_road_objects_tunnel.name
                         ];
        skos:definition  "Tunnels are modeled as objects in ASAM OpenDRIVE. The road with the tunnel object defines the part of the road that is the tunnel or the underpass.\r\nTunnels are valid for the complete cross section of a road unless a lane validity element with further restrictions is provided as child element"@en .

