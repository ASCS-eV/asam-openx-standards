odr:T_road_lanes_laneSection_lr_lane_width
        rdf:type         owl:Class;
        rdfs:comment     "Lane widths widen or narrow lanes along the t-coordinate within lane sections.\r\nLane width and lane border elements are mutually exclusive within the same lane group. If both width and lane border elements are present for a lane section in the ASAM OpenDRIVE file, the application must use the information from the <width> elements."@en;
        rdfs:label       "t_road_lanes_laneSection_lr_lane_width"@en;
        rdfs:subClassOf  odr:_OpenDriveElement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road_lanes_laneSection_lr_lane_width.a;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road_lanes_laneSection_lr_lane_width.d;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road_lanes_laneSection_lr_lane_width.sOffset;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road_lanes_laneSection_lr_lane_width.c;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road_lanes_laneSection_lr_lane_width.b;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        skos:definition  "Lane widths widen or narrow lanes along the t-coordinate within lane sections.\r\nLane width and lane border elements are mutually exclusive within the same lane group. If both width and lane border elements are present for a lane section in the ASAM OpenDRIVE file, the application must use the information from the <width> elements."@en .

