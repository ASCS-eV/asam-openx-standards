odr:T_road_lanes_laneSection_lcr_lane_link
        rdf:type         owl:Class;
        rdfs:comment     "For links between lanes with an identical road reference line, the lane predecessor and successor information provide the IDs of lanes on the preceding or following lane section.\r\nFor links between lanes with different road reference line,  the lane predecessor and successor information provide the IDs of lanes on the first or last lane section of the other road reference line depending on the contact point of the road linkage.\r\nThis element may only be omitted, if lanes end at a junction or have no physical link."@en;
        rdfs:label       "t_road_lanes_laneSection_lcr_lane_link"@en;
        rdfs:subClassOf  odr:_OpenDriveElement;
        skos:definition  "For links between lanes with an identical road reference line, the lane predecessor and successor information provide the IDs of lanes on the preceding or following lane section.\r\nFor links between lanes with different road reference line,  the lane predecessor and successor information provide the IDs of lanes on the first or last lane section of the other road reference line depending on the contact point of the road linkage.\r\nThis element may only be omitted, if lanes end at a junction or have no physical link."@en .

odr:T_junctionGroup  rdf:type  owl:Class;
        rdfs:comment     "Junction groups indicate for routing that the grouped junctions belong to the same node and are commonly seen as one big junction, for example roundabouts or highway interchanges.\r\nThe <junctionGroup> element is split into a header element and a series of member elements."@en;
        rdfs:label       "t_junctionGroup"@en;
        rdfs:subClassOf  odr:_OpenDriveElement;
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:minQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_junctionGroup_junctionReference;
                           owl:onProperty               odr:T_junctionGroup.junctionReference
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               owl:Class;
                           owl:onProperty            odr:T_junctionGroup.type;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:string;
                           owl:onProperty            odr:T_junctionGroup.id;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:string;
                           owl:onProperty               odr:T_junctionGroup.name
                         ];
        skos:definition  "Junction groups indicate for routing that the grouped junctions belong to the same node and are commonly seen as one big junction, for example roundabouts or highway interchanges.\r\nThe <junctionGroup> element is split into a header element and a series of member elements."@en .

