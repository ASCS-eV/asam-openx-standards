        rdfs:subClassOf  odr:_OpenDriveElement;
        skos:definition  "This signal semantic has no meaning on its own. It specifies the type of the traffic participant a restriction is made for. See Section 14.8.2, “Traffic participants” for details."@en .

odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit
        rdf:type         owl:Class;
        rdfs:comment     "Irregular road markings that cannot be described by repetitive line patterns may be described by individual road marking elements. These explicit definitions also contain <line> elements for the line definition, however, these lines will not be repeated automatically as in repetitive road marking types. In ASAM OpenDRIVE, irregular road marking types and lines are represented by <explicit> elements within elements. The line definitions are contained in <line> elements within the <explicit> element.\r\nThe <explicit> element should specifically be used for measurement data."@en;
        rdfs:label       "t_road_lanes_laneSection_lcr_lane_roadMark_explicit"@en;
        rdfs:subClassOf  odr:_OpenDriveElement;
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:minQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit_line;
                           owl:onProperty               odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit.line
                         ];
        skos:definition  "Irregular road markings that cannot be described by repetitive line patterns may be described by individual road marking elements. These explicit definitions also contain <line> elements for the line definition, however, these lines will not be repeated automatically as in repetitive road marking types. In ASAM OpenDRIVE, irregular road marking types and lines are represented by <explicit> elements within elements. The line definitions are contained in <line> elements within the <explicit> element.\r\nThe <explicit> element should specifically be used for measurement data."@en .

odr:T_road_lanes_laneSection_lr_lane_material
        rdf:type         owl:Class;
        rdfs:comment     "Stores information about the material of lanes. Each element is valid until a new element is defined. If multiple elements are defined, they must be listed in ascending order."@en;
        rdfs:label       "t_road_lanes_laneSection_lr_lane_material"@en;
        rdfs:subClassOf  odr:_OpenDriveElement;
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:double;
                           owl:onProperty               odr:T_road_lanes_laneSection_lr_lane_material.roughness
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road_lanes_laneSection_lr_lane_material.friction;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:string;
                           owl:onProperty               odr:T_road_lanes_laneSection_lr_lane_material.surface
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road_lanes_laneSection_lr_lane_material.sOffset;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        skos:definition  "Stores information about the material of lanes. Each element is valid until a new element is defined. If multiple elements are defined, they must be listed in ascending order."@en .

