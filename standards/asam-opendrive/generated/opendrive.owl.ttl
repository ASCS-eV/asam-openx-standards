odr:T_station_platform_segment
        rdf:type         owl:Class;
        rdfs:comment     "Segments are parts of platforms.\r\nEach <platform> element is valid on one or more track segments. The <segment> element must be specified."@en;
        rdfs:label       "t_station_platform_segment"@en;
        rdfs:subClassOf  odr:_OpenDriveElement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               owl:Class;
                           owl:onProperty            odr:T_station_platform_segment.side;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_station_platform_segment.sEnd;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_station_platform_segment.sStart;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:string;
                           owl:onProperty            odr:T_station_platform_segment.roadId;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        skos:definition  "Segments are parts of platforms.\r\nEach <platform> element is valid on one or more track segments. The <segment> element must be specified."@en .

