odr:T_road_lanes_laneSection
        rdf:type         owl:Class;
        rdfs:comment     "A lane section splits a road into multiple parts whenever the number of lanes or their function changes.\r\nThe distance between two succeeding lane sections shall not be zero.\r\nFor easier navigation through an ASAM OpenDRIVE road description, the lanes within a lane section are grouped into left, center, and right lanes. Each lane section shall contain one <center> element and at least one <right> or <left> element."@en;
        rdfs:label       "t_road_lanes_laneSection"@en;
        rdfs:subClassOf  odr:_OpenDriveElement;
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:boolean;
                           owl:onProperty               odr:T_road_lanes_laneSection.singleSide
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:double;
                           owl:onProperty               odr:T_road_lanes_laneSection.length
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_lanes_laneSection_right;
                           owl:onProperty               odr:T_road_lanes_laneSection.right
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_lanes_laneSection_left;
                           owl:onProperty               odr:T_road_lanes_laneSection.left
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               odr:T_road_lanes_laneSection_center;
                           owl:onProperty            odr:T_road_lanes_laneSection.center;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:double;
                           owl:onProperty            odr:T_road_lanes_laneSection.s;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        skos:definition  "A lane section splits a road into multiple parts whenever the number of lanes or their function changes.\r\nThe distance between two succeeding lane sections shall not be zero.\r\nFor easier navigation through an ASAM OpenDRIVE road description, the lanes within a lane section are grouped into left, center, and right lanes. Each lane section shall contain one <center> element and at least one <right> or <left> element."@en .

