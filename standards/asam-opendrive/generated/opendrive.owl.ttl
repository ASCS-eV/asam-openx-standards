        rdf:type         owl:ObjectProperty;
        rdfs:comment     "Country code of the road, see ISO 3166-1, alpha-2 codes."@en;
        rdfs:domain      odr:T_road_type;
        rdfs:label       "country"@en;
        rdfs:range       odr:E_countryCode;
        skos:definition  "Country code of the road, see ISO 3166-1, alpha-2 codes."@en .

odr:T_road_objects_object_surface
        rdf:type         owl:Class;
        rdfs:comment     "Used to describe the road surface elevation of an object."@en;
        rdfs:label       "t_road_objects_object_surface"@en;
        rdfs:subClassOf  odr:_OpenDriveElement;
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_objects_object_surface_CRG;
                           owl:onProperty               odr:T_road_objects_object_surface.cRG
                         ];
        skos:definition  "Used to describe the road surface elevation of an object."@en .

odr:T_road_surface_CRG.xOffset
        rdf:type         owl:DatatypeProperty;
        rdfs:comment     "x-offset for translating the CRG center line (default = 0.0). Only allowed for mode global."@en;
        rdfs:domain      odr:T_road_surface_CRG;
        rdfs:label       "xOffset"@en;
        rdfs:range       xsd:double;
        skos:definition  "x-offset for translating the CRG center line (default = 0.0). Only allowed for mode global."@en .
