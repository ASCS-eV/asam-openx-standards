odr:T_road_objects_object_outlines_outline
        rdf:type         owl:Class;
        rdfs:comment     "Defines a series of corner points, including the height of the object relative to the road reference line. For areas, the points should be listed in counter-clockwise order. The inner area of the described outline may be filled with a filling type, such as grass, concrete, asphalt, or pavement.\r\nAn element shall be followed by two or more <cornerRoad> elements, by two or more <cornerLocal> elements, or by one or more <curveLocal> elements.\r\nASAM OpenDRIVE 1.4 outline definitions (without <outlines> parent element) shall still be supported."@en;
        rdfs:label       "t_road_objects_object_outlines_outline"@en;
        rdfs:subClassOf  odr:_OpenDriveElement;
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:boolean;
                           owl:onProperty               odr:T_road_objects_object_outlines_outline.closed
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:nonNegativeInteger;
                           owl:onProperty               odr:T_road_objects_object_outlines_outline.id
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onDataRange              xsd:boolean;
                           owl:onProperty               odr:T_road_objects_object_outlines_outline.outer
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  owl:Class;
                           owl:onProperty               odr:T_road_objects_object_outlines_outline.fillType
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  odr:T_road_objects_object_markings;
                           owl:onProperty               odr:T_road_objects_object_outlines_outline.markings
                         ];
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  owl:Class;
                           owl:onProperty               odr:T_road_objects_object_outlines_outline.laneType
                         ];
        skos:definition  "Defines a series of corner points, including the height of the object relative to the road reference line. For areas, the points should be listed in counter-clockwise order. The inner area of the described outline may be filled with a filling type, such as grass, concrete, asphalt, or pavement.\r\nAn element shall be followed by two or more <cornerRoad> elements, by two or more <cornerLocal> elements, or by one or more <curveLocal> elements.\r\nASAM OpenDRIVE 1.4 outline definitions (without <outlines> parent element) shall still be supported."@en .

