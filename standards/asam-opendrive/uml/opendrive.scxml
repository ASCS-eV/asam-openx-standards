                      <sc:descriptorValues>
                        <sc:DescriptorValue>Each type definition shall contain one or more line definitions with additional information about the lines that the road marking is composed of.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Each type definition shall contain one or more line definitions with additional information about the lines that the road marking is composed of.</sc:DescriptorValue>
