                      <sc:descriptorValues>
                        <sc:DescriptorValue>Road elevation specifies the elevation along the road reference line, that is in s-direction.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Road elevation specifies the elevation along the road reference line, that is in s-direction.</sc:DescriptorValue>
