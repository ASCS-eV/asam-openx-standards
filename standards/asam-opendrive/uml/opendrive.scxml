                  <sc:name>t_road_lanes_laneSection_lr_lane_speed</sc:name>
                  <sc:id>116</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Defines the maximum allowed speed on a given lane. Each element is valid in direction of the increasing s-coordinate until a new element is defined.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Defines the maximum allowed speed on a given lane. Each element is valid in direction of the increasing s-coordinate until a new element is defined.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
                  <sc:supertypes>
                    <sc:SupertypeId>159</sc:SupertypeId>
                  </sc:supertypes>
                  <sc:properties>
                    <sc:Property>
                      <sc:name>sOffset</sc:name>
                      <sc:id>116_195</sc:id>
                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>s-coordinate of start position, relative to the position of the preceding &lt;laneSection&gt; element</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
