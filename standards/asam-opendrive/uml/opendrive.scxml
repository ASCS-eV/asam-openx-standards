                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A semi-tractor is a vehicle designed for towing semi-trailers for the transportation of heavy loads.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>A semi-tractor is a vehicle designed for towing semi-trailers for the transportation of heavy loads.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:documentation>
