                      <sc:descriptors>
                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>If not specified, direction is determined by the combination of &lt;left&gt; or &lt;right&gt; lane grouping and the values LHT or RHT of the @rule attribute of a road. The standard direction can be overwritten with this attribute.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
                        <sc:documentation>
