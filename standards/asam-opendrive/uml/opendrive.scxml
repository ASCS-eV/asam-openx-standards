                <sc:Class>
                  <sc:name>t_road_lanes</sc:name>
                  <sc:id>38</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Lanes are an essential part of all roads. Lanes are attached to the road reference line and are defined from inside to outside.&#xD;&#xA;Lanes contain a series of lane section elements that define the characteristics of the road cross sections with respect to the lanes along the road reference line.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
