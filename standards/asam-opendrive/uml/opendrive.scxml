                <sc:Class>
                  <sc:name>t_road_railroad</sc:name>
                  <sc:id>82</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Container for all railroad definitions that shall be applied along a road.&#xD;&#xA;The available set of railroad elements is currently limited to the definition of switches. All other entries shall be covered with the existing elements, for example, track definition by &lt;road&gt;, signal definition by &lt;signal&gt;, etc. Railroad-specific elements are defined against the background of streetcar applications.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Container for all railroad definitions that shall be applied along a road.&#xD;&#xA;The available set of railroad elements is currently limited to the definition of switches. All other entries shall be covered with the existing elements, for example, track definition by &lt;road&gt;, signal definition by &lt;signal&gt;, etc. Railroad-specific elements are defined against the background of streetcar applications.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
