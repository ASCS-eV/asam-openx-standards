                <sc:Class>
                  <sc:name>t_road_lanes_laneSection_lr_lane_width</sc:name>
                  <sc:id>52</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Lane widths widen or narrow lanes along the t-coordinate within lane sections.&#xD;&#xA;Lane width and lane border elements are mutually exclusive within the same lane group. If both width and lane border elements are present for a lane section in the ASAM OpenDRIVE file, the application must use the information from the &lt;width&gt; elements.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Lane widths widen or narrow lanes along the t-coordinate within lane sections.&#xD;&#xA;Lane width and lane border elements are mutually exclusive within the same lane group. If both width and lane border elements are present for a lane section in the ASAM OpenDRIVE file, the application must use the information from the &lt;width&gt; elements.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:documentation>
                  </sc:descriptors>
