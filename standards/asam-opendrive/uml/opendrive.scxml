                  <sc:id>37</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Defined as the road section’s surface relative to the reference plane. There may be several shape definitions at one s-position that have different t-values, thereby describing the curvy shape of the road.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
                    <sc:documentation>
                      <sc:descriptorValues>
