                        <sc:definition>
                          <sc:descriptorValues>
                            <sc:DescriptorValue>Accumulated width of the road marking. In case of several &lt;line&gt; elements this @width is the sum of all @width of &lt;line&gt; elements and spaces in between, necessary to form the road marking. This attribute supersedes the definition in the &lt;roadMark&gt; element.</sc:DescriptorValue>
                          </sc:descriptorValues>
                        </sc:definition>
