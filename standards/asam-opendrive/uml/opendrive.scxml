                  <sc:id>89</sc:id>
                  <sc:descriptors>
                    <sc:definition>
                      <sc:descriptorValues>
                        <sc:DescriptorValue>Junction groups indicate for routing that the grouped junctions belong to the same node and are commonly seen as one big junction, for example roundabouts or highway interchanges.&#xD;&#xA;The &lt;junctionGroup&gt; element is split into a header element and a series of member elements.</sc:DescriptorValue>
                      </sc:descriptorValues>
                    </sc:definition>
