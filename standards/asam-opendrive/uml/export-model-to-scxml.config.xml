<?xml version="1.0" encoding="UTF-8"?>
<!--
  ShapeChange "ModelExport" configuration: ASAM Enterprise Architect model -> open SCXML.

  This is the ONLY step that requires Enterprise Architect (inputModelType=EA7 reads
  the proprietary .qeax). Its output - the committed *.scxml (+ .scxml.zip) next to
  this file - is the open, tool-neutral model that every downstream step (OWL, SHACL,
  XSD) consumes WITHOUT EA.

  Run (override the input .qeax on the command line):
    java -Djava.library.path="C:/Program Files/Sparx Systems/EA/Java API" \
         -jar ShapeChange-4.1.0-SNAPSHOT.jar -c export-model-to-scxml.config.xml \
         -x "$inputFile$" "C:/path/to/ASAM_OpenDRIVE.qeax"

  ShapeChange must be built from source (see the "Reproducing the export" section of
  ../README.md for the exact commit, the eaapi Maven install step, and why a commit is
  cited rather than the 4.0.0 release).

  The ModelExport target writes scxml-out/INPUT/ModelExport.zip (zipOutput=true) and,
  when unzipped, the plain SCXML document used as the source-of-truth open model.

  Portability: this configuration runs as committed. It declares no xi:include of
  ShapeChange's StandardAliases.xml, which earlier versions of this file pointed at via an
  absolute Windows path. That include is not needed here: it only maps non-well-known
  stereotype spellings onto well-known ones, and "addStereotypes" below carries every
  stereotype verbatim instead, which is what this model needs - its stereotypes are the EA
  XML Schema profile (XSDattribute, XSDcomplexType, XSDunion, ...), and no alias in that
  file maps to any of them.
-->
<ShapeChangeConfiguration
    xmlns="http://www.interactive-instruments.de/ShapeChange/Configuration/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.interactive-instruments.de/ShapeChange/Configuration/1.1 http://shapechange.net/resources/schema/ShapeChangeConfiguration.xsd">
  <input>
    <parameter name="inputModelType" value="EA7"/>
    <!-- Provide the .qeax via the command-line override: -x "$inputFile$" "<path>.qeax" -->
    <parameter name="inputFile" value="$inputFile$"/>
    <parameter name="appSchemaNameRegex" value=".*"/>
    <parameter name="publicOnly" value="false"/>
    <parameter name="checkingConstraints" value="disabled"/>
    <!-- Orders the *schemas* ShapeChange processes. Class order within a schema is not this
         parameter's job, but the exporter now emits classes in name order by default, so the
         committed model is a function of the model's names rather than of Enterprise
         Architect's internal element ids. That matters because EA ids shift when the project
         is edited, which would otherwise reorder this file for no semantic reason.
         "sortedOutput" is deliberately NOT set: it was verified byte-for-byte inert here,
         because the order it requests is the order already produced. -->
    <parameter name="sortedSchemaOutput" value="true"/>
    <!-- Carry every stereotype the model applies, not just ShapeChange's well-known set.
         The ASAM models are stereotyped with the EA XML Schema profile, and without this the
         export silently drops 691 of 775 stereotypes - including all 468 "XSDattribute",
         which state which properties are XML attributes and correspond exactly to the 468
         xs:attribute declarations in the normative schema. -->
    <parameter name="addStereotypes" value="*"/>
    <!-- Carry the tagged values that hold model information, named explicitly rather than
         with "*". Every tag listed here was verified to be populated in the model; the ones
         left out were verified empty and would add ~440 KB of blank elements:
           memberNames          98 present, 0 with a value
           minOccurs/maxOccurs  56 present, 1 with a value  (multiplicity already arrives
                                                             as cardinality)
           fractionDigits, totalDigits, whiteSpace,
           length, minLength, maxLength, maxExclusive
                                15 present each, 0 with a value
         The facets that *are* populated - minInclusive, maxInclusive, minExclusive,
         pattern, and unit - are in ShapeChange's well-known set already and need no entry
         here. Note that only six facet values exist in the whole model.
           use                  365 values, required/optional - attribute requiredness
           position             244 values - element order within a content model
           introducedAtVersion  242 values, 1.6.0..1.9.0 - per-element version provenance
           modelGroup           161 values, sequence/group/choice - XSD content-model kind
           mixed                100 values
           deprecatedWithVersion 41 values -->
    <parameter name="representTaggedValues"
               value="use,position,introducedAtVersion,modelGroup,mixed,deprecatedWithVersion"/>
  </input>
  <log>
    <parameter name="reportLevel" value="INFO"/>
  </log>
  <targets>
    <Target class="de.interactive_instruments.shapechange.core.target.modelexport.ModelExport" mode="enabled">
      <targetParameter name="outputDirectory" value="scxml-out"/>
      <targetParameter name="zipOutput" value="true"/>
      <!-- Without this the zip entry is called ModelExport.xml, which says nothing about
           which standard it holds. -->
      <targetParameter name="outputFilename" value="opendrive"/>
    </Target>
  </targets>
</ShapeChangeConfiguration>
