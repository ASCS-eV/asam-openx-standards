<?xml version="1.0" encoding="UTF-8"?>
<!--
  ASAM OpenSCENARIO XML: UML (SCXML) -> OWL 2, via the ShapeChange ISO 19150-2 target.

  Driven by scripts/generate_semantic_artifacts.py, which substitutes {SHAPECHANGE_RESOURCES},
  {PIPELINE} and {OUT} before handing this file to ShapeChange. See pipeline/README.md.

  This is the OpenDRIVE configuration with three deliberate differences, each forced by the
  model rather than chosen:

  1. The schema package is declared here, not read from the model. The OpenSCENARIO model
     carries no tagged values at all - no targetNamespace anywhere - so PackageInfo below is
     what makes OpenSCENARIO a schema package as far as ShapeChange is concerned
     (PackageInfoImpl.isSchema falls back to the namespace configured for a package name).
     One consequence is welcome: exactly one schema resolves, so
     rule-owl-pkg-singleOntologyPerSchema is satisfied cleanly and the run produces none of
     the 227 errors OpenDRIVE's seven identically-tagged sub-packages produce.

  2. The namespace follows OpenDRIVE's convention rather than the XSD. Neither standard's
     normative XSD declares a targetNamespace - both are unqualified - so there is no
     namespace to inherit. `.../openscenario_schema` is the same shape as the
     `.../opendrive_schema` value the OpenDRIVE model carries in its tagged values, so the
     two ontologies are named consistently.

  3. No sortedSchemaOutput. It orders classes within a schema for the XML Schema target and has
     no effect on the OWL target, which sorts by IRI. It is present in the OpenDRIVE config for
     historical reasons and is not carried over.

  Everything else - the encoding rule, the map entries, the descriptor targets - is identical
  to the OpenDRIVE configuration on purpose: the two ontologies should differ because the
  models differ, not because they were generated differently.
-->
<ShapeChangeConfiguration
    xmlns="http://www.interactive-instruments.de/ShapeChange/Configuration/1.1"
    xmlns:xi="http://www.w3.org/2001/XInclude"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.interactive-instruments.de/ShapeChange/Configuration/1.1 file:///{SHAPECHANGE_RESOURCES}/schema/ShapeChangeConfiguration.xsd">
  <input>
    <parameter name="inputModelType" value="SCXML"/>
    <!-- Committed, EA-free source model. Paths are relative to the repository root. -->
    <parameter name="inputFile" value="standards/asam-openscenario-xml/uml/openscenario.scxml"/>
    <parameter name="appSchemaNamespaceRegex" value="http://code.asam.net/simulation/standard/openscenario_schema"/>
    <parameter name="publicOnly" value="false"/>
    <parameter name="checkingConstraints" value="disabled"/>
    <packages>
      <PackageInfo packageName="OpenSCENARIO" nsabr="osc" ns="http://code.asam.net/simulation/standard/openscenario_schema"/>
    </packages>
    <xi:include href="file:///{SHAPECHANGE_RESOURCES}/config/StandardAliases.xml"/>
  </input>
  <log>
    <parameter name="reportLevel" value="INFO"/>
    <parameter name="logFile" value="{OUT}/openscenario-owl-log.xml"/>
  </log>
  <targets>
    <TargetOwl class="de.interactive_instruments.shapechange.core.target.ontology.OWLISO19150" mode="enabled">
      <targetParameter name="outputDirectory" value="{OUT}"/>
      <targetParameter name="language" value="en"/>
      <targetParameter name="defaultEncodingRule" value="asam-owl"/>
      <targetParameter name="ontologyNameCode" value="openscenario"/>
      <targetParameter name="URIbase" value="http://code.asam.net/simulation/standard"/>
      <rules>
        <EncodingRule name="asam-owl">
          <rule name="rule-owl-pkg-singleOntologyPerSchema"/>
          <rule name="rule-owl-pkg-ontologyName-code"/>
          <rule name="rule-owl-pkg-versionInfo"/>
          <rule name="rule-owl-cls-encode-featuretypes"/>
          <rule name="rule-owl-cls-encode-objecttypes"/>
          <rule name="rule-owl-cls-encode-datatypes"/>
          <rule name="rule-owl-cls-encode-basictypes"/>
          <!--
            Encodes each UML enumeration as an rdfs:Datatype with owl:oneOf over its
            literals. rule-owl-cls-enumerationAsCodelist is the alternative and is NOT
            used: it makes the enumeration fall through to the code list encoding, which
            only applies when rule-owl-cls-codelist-191502 or -external is also present.
            Without one of those the class reaches the default branch and is silently
            dropped - which is what happened to all 55 unmapped OpenDRIVE enumerations
            until this rule replaced it. The two rules are mutually exclusive.
          -->
          <rule name="rule-owl-cls-iso191502Enumeration"/>
          <rule name="rule-owl-cls-generalization"/>
          <!--
            OpenSCENARIO models 48 classes as <<union>>, against OpenDRIVE's none, so this
            rule carries considerably more of the encoding here. A union whose members are
            typed by other classes is encoded as owl:unionOf over their IRIs.
          -->
          <rule name="rule-owl-cls-union"/>
          <rule name="rule-owl-prop-general"/>
          <rule name="rule-owl-prop-localScopeAll"/>
          <rule name="rule-owl-prop-range-global"/>
          <rule name="rule-owl-prop-multiplicityAsQualifiedCardinalityRestriction"/>
        </EncodingRule>
      </rules>
      <xi:include href="{PIPELINE}/mapentries-asam.xml"/>
      <xi:include href="file:///{SHAPECHANGE_RESOURCES}/config/StandardMapEntries_iso19103-owl.xml"/>
      <xi:include href="file:///{SHAPECHANGE_RESOURCES}/config/StandardNamespaces-owl.xml"/>
      <descriptorTargets>
        <DescriptorTarget appliesTo="all" target="rdfs:label" format="langString" template="[[name]]"/>
        <DescriptorTarget appliesTo="all" target="skos:definition" format="langString" template="[[definition]]"/>
        <DescriptorTarget appliesTo="all" target="rdfs:comment" format="langString" template="[[documentation]]"/>
      </descriptorTargets>
    </TargetOwl>
  </targets>
</ShapeChangeConfiguration>
